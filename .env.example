WHOEATS_GOOGLE_MAPS_WEB_API_KEY=YOUR_GOOGLE_MAPS_WEB_API_KEY
WHOEATS_MAP_PINS_API_URL=https://your-api.example.com/map/pins
WHOEATS_PLACE_DETAIL_API_TEMPLATE=https://your-api.example.com/places/{placeId}
WHOEATS_POSTED_PIN_PLACE_ID=YOUR_DEFAULT_POSTED_PIN_PLACE_ID
WHOEATS_POSTED_PIN_PLACE_NAME=YOUR_DEFAULT_POSTED_PIN_PLACE_NAME
WHOEATS_IOS_MAPS_API_KEY=YOUR_IOS_MAPS_API_KEY
WHOEATS_ANDROID_MAPS_API_KEY=YOUR_ANDROID_MAPS_API_KEY

# Valiark 共有 Supabase（valiark-dev）。ドキュメントの SUPABASE_* と併用可。
WHOEATS_SUPABASE_URL=https://rothadmykmuxncagbwqd.supabase.co
WHOEATS_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_KEY
# フォールバック（他リポジトリと同じキー名だけ置く場合）
# SUPABASE_URL=https://rothadmykmuxncagbwqd.supabase.co
# SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Who eats ドメイン表の接頭辞・プロフィール表（migration 0003: public.users → whoeats_users）
WHOEATS_DB_TABLE_PREFIX=whoeats_
WHOEATS_SUPABASE_PROFILES_TABLE=whoeats_users

# Dashboard に登録する共有メール / PKCE リダイレクト（全 Valiark アプリで同一スキーム）
VALIARK_AUTH_REDIRECT_URL=io.valiark.auth://callback

# Optional: Panda / 共通 IdP の OAuth 開始 URL（ブラウザで開く）
WHOEATS_PANDA_OAUTH_URL=
# Optional: override UUID of seeded dev place (migration 0002)
WHOEATS_DEFAULT_DEV_PLACE_UUID=
