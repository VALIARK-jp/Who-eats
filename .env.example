# コピーして `.env` にし、値を埋める（`.env` は gitignore）。
# 運用ルール: docs/valiark_client_secrets_playbook.md

# Google / Maps（ネイティブキーは iOS Info.plist / Android Gradle から参照）
WHOEATS_GOOGLE_MAPS_WEB_API_KEY=
WHOEATS_MAP_PINS_API_URL=
WHOEATS_PLACE_DETAIL_API_TEMPLATE=
WHOEATS_POSTED_PIN_PLACE_ID=
WHOEATS_POSTED_PIN_PLACE_NAME=
WHOEATS_IOS_MAPS_API_KEY=
WHOEATS_ANDROID_MAPS_API_KEY=

# Valiark 共有 Supabase（チームから配布。リポに実値をコミットしない）
WHOEATS_SUPABASE_URL=
WHOEATS_SUPABASE_ANON_KEY=
# フォールバック（他リポとキー名を揃える場合）
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# Who eats ドメイン表（migration 0003）
WHOEATS_DB_TABLE_PREFIX=whoeats_
WHOEATS_SUPABASE_PROFILES_TABLE=whoeats_users

# Who eats 専用（Panda Talk は PANDA_TALK_AUTH_REDIRECT_URL=io.valiark.pandatalk://callback）
WHOEATS_AUTH_REDIRECT_URL=io.valiark.whoeats://callback
# 後方互換（未設定時は上記キーを推奨）
# VALIARK_AUTH_REDIRECT_URL=io.valiark.auth://callback

# Optional
WHOEATS_PANDA_OAUTH_URL=
WHOEATS_DEFAULT_DEV_PLACE_UUID=
WHOEATS_TERMS_URL=
WHOEATS_PRIVACY_URL=
